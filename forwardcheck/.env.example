# Copy to .env and fill in what you have. All of these have free tiers.
# At least one LLM key is required. Gemini + OpenRouter together is a good free setup.

# LLM providers (tried in this order; any without a key are skipped)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides (OpenRouter free models are auto-discovered if this is empty)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
OPENROUTER_MODELS=

# Evidence retrieval (all optional; the keyless DuckDuckGo search is the fallback)
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=

# WhatsApp via Twilio sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public https URL of this server (ngrok etc). Needed to verify Twilio's signature.
PUBLIC_BASE_URL=
VALIDATE_TWILIO=1
